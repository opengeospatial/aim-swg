<rdf:RDF
    xmlns:qudt="http://qudt.org/schema/qudt/"
    xmlns:af-inspire="http://inspire.ec.europa.eu/schemas/af/3.0#"
    xmlns:saref="https://saref.etsi.org/core/"
    xmlns:common="http://portele.de/ont/inspire/baseInspire#"
    xmlns:dct="http://purl.org/dc/terms/"
    xmlns:cf="http://purl.oclc.org/NET/ssnx/cf/cf-property#"
    xmlns:saref4agri="https://saref.etsi.org/saref4agri/"
    xmlns:prov="http://www.w3.org/ns/prov#"
    xmlns:sosa="http://www.w3.org/ns/sosa/"
    xmlns:iso19103="http://def.seegrid.csiro.au/isotc211/iso19103/2005/basic#"
    xmlns:skos="http://www.w3.org/2004/02/skos/core#"
    xmlns:dim="http://purl.oclc.org/NET/ssnx/qu/dim#"
    xmlns:foodie="http://foodie-cloud.com/model/foodie#"
    xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
    xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
    xmlns:schema="https://schema.org/"
    xmlns:cf-feature="http://purl.oclc.org/NET/ssnx/cf/cf-feature#"
    xmlns:fiware="https://smartdatamodels.org/"
    xmlns:iso19109="http://def.seegrid.csiro.au/isotc211/iso19109/2005/feature#"
    xmlns:iso19150-2="http://def.seegrid.csiro.au/isotc211/iso19150/-2/2012/basic#"
    xmlns:fiware-weather="https://smartdatamodels.org/dataModel.Weather/"
    xmlns:stat="http://data.europa.eu/m8g/"
    xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
    xmlns:quantity="http://purl.oclc.org/NET/ssnx/qu/quantity#"
    xmlns:owl="http://www.w3.org/2002/07/owl#"
    xmlns:qu="http://purl.oclc.org/NET/ssnx/qu/qu#"
    xmlns:qb="http://purl.org/linked-data/cube#"
    xmlns:geo="http://www.opengis.net/ont/geosparql#"
    xmlns:dcat="http://www.w3.org/ns/dcat#"
    xmlns="https://w3id.org/cybele/"
    xmlns:act-inspire="http://inspire.ec.europa.eu/schemas/act-core/3.0#"
    xmlns:ssn="http://www.w3.org/ns/ssn/"
    xmlns:foaf="http://xmlns.com/foaf/0.1/"
    xmlns:fiware-agrifood="https://smartdatamodels.org/dataModel.Agrifood/" > 
  <rdf:Description rdf:nodeID="A0">
    <foaf:name>OGC</foaf:name>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A1">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:resource="https://saref.etsi.org/core/FeatureOfInterest"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A2">
    <foaf:name>Ioanna Roussaki</foaf:name>
    <schema:affiliation rdf:nodeID="A3"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://saref.etsi.org/core/isMeasuredIn">
    <skos:historyNote xml:lang="en">V3.2.1: Relaxed domain of saref:isMeasuredIn so it can apply to saref:PropertyValue as well as saref:Measurement. The new range will be enforced in the next major revision of SAREF.</skos:historyNote>
    <rdfs:label xml:lang="en">is measured in</rdfs:label>
    <rdfs:comment xml:lang="en">A relationship identifying the unit of measure used for a certain entity.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://saref.etsi.org/core/hasResult">
    <rdfs:isDefinedBy rdf:resource="https://saref.etsi.org/core/"/>
    <skos:historyNote xml:lang="en">V3.2.1: Introduced saref:hasResult as part of general will to make SAREF and SOSA/SSN converge.</skos:historyNote>
    <rdfs:domain rdf:resource="https://saref.etsi.org/core/ProcedureExecution"/>
    <rdfs:comment xml:lang="en">Links a procedure execution (e.g., an observation) to its result (e.g., a property value).</rdfs:comment>
    <rdfs:label xml:lang="en">has result</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://saref.etsi.org/core/isControlledBy">
    <skos:historyNote xml:lang="en">V3.2.1: Introduced property saref:isControlledBy.</skos:historyNote>
    <rdfs:comment xml:lang="en">Links a feature, property, or state, to the device, function, command, or procedure execution, that controls it.</rdfs:comment>
    <rdfs:label xml:lang="en">is controlled by</rdfs:label>
    <owl:inverseOf rdf:resource="https://saref.etsi.org/core/controls"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://saref.etsi.org/core/controls">
    <skos:historyNote xml:lang="en">V3.2.1: Introduced property saref:controls, as sub-property of saref:targets. and generalization of saref:controlsProperty.</skos:historyNote>
    <rdfs:comment xml:lang="en">Links a device, function, command, or procedure execution, to the feature, property, or state, it controls.</rdfs:comment>
    <rdfs:label xml:lang="en">controls</rdfs:label>
    <owl:inverseOf rdf:resource="https://saref.etsi.org/core/isControlledBy"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A4">
    <rdf:rest rdf:nodeID="A1"/>
    <rdf:first rdf:resource="https://saref.etsi.org/core/FeatureKind"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://saref.etsi.org/core/hasProperty">
    <rdfs:isDefinedBy rdf:resource="https://saref.etsi.org/core/"/>
    <rdfs:range rdf:resource="https://saref.etsi.org/core/Property"/>
    <rdfs:domain rdf:nodeID="A5"/>
    <skos:historyNote xml:lang="en">V3.2.1: applicability of saref:hasProperty is relaxed to also saref:FeatureKind</skos:historyNote>
    <rdfs:comment xml:lang="en">Links a feature kind or a feature of interest to one of its properties.</rdfs:comment>
    <rdfs:label xml:lang="en">has property</rdfs:label>
    <owl:inverseOf rdf:resource="https://saref.etsi.org/core/isPropertyOf"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A6">
    <owl:unionOf rdf:nodeID="A4"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A7">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:resource="https://saref.etsi.org/core/FeatureOfInterest"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://saref.etsi.org/core/observes">
    <rdfs:isDefinedBy rdf:resource="https://saref.etsi.org/core/"/>
    <skos:historyNote xml:lang="en">V3.2.1: Introduced property saref:observes, as sub-property of saref:targets. and generalization of measures.</skos:historyNote>
    <rdfs:comment xml:lang="en">Links a device, function, command, or procedure execution, to the feature, property, or state, it observes.</rdfs:comment>
    <rdfs:label xml:lang="en">observes</rdfs:label>
    <owl:inverseOf rdf:resource="https://saref.etsi.org/core/isObservedBy"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/demeter/agri/agriProperty">
    <foaf:maker rdf:nodeID="A8"/>
    <dct:contributor rdf:nodeID="A2"/>
    <owl:imports rdf:resource="https://w3id.org/demeter/agri/agriCommon"/>
    <owl:versionInfo>3.5</owl:versionInfo>
    <owl:versionIRI rdf:resource="https://w3id.org/demeter/agri/agriProperty/3.0"/>
    <dct:contributor rdf:nodeID="A9"/>
    <dct:rights xml:lang="en">This vocabulary is distributed under Creative Commons Attribution 4.0 License - http://creativecommons.org/licenses/by/4.0</dct:rights>
    <dct:contributor rdf:nodeID="A10"/>
    <dct:creator rdf:nodeID="A11"/>
    <rdfs:comment xml:lang="en">The DEMETER Agriculture Information Model (AIM) is the common vocabulary in DEMETER project providing the basis for semantic interoperability across smart farming solutions</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <skos:historyNote xml:lang="en">V3.5: re-aligns with v4.1.1 of SAREF core model</skos:historyNote>
    <dct:title xml:lang="en">DEMETER AgriProperty</dct:title>
    <dct:description xml:lang="en">The DEMETER AgriProperty is one of the agri profiles of DEMETER AIM. This profile was created by reusing and aligning well-known ontologies and vocabularies</dct:description>
    <rdfs:label>DEMETER AgriProperty</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A3">
    <foaf:name>ICCS</foaf:name>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A8">
    <foaf:name>DEMETER project</foaf:name>
    <foaf:homepage rdf:resource="https://h2020-demeter.eu/"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://saref.etsi.org/core/madeExecution">
    <rdfs:range rdf:resource="https://saref.etsi.org/core/ProcedureExecution"/>
    <rdfs:domain rdf:resource="https://saref.etsi.org/core/FeatureOfInterest"/>
    <rdfs:comment xml:lang="en">Links an entity (e.g., device) to the procedure execution it made.</rdfs:comment>
    <rdfs:label xml:lang="en">made execution</rdfs:label>
    <owl:inverseOf rdf:resource="https://saref.etsi.org/core/madeBy"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A12">
    <rdf:rest rdf:nodeID="A7"/>
    <rdf:first rdf:resource="https://saref.etsi.org/core/FeatureKind"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://saref.etsi.org/core/madeBy">
    <rdfs:isDefinedBy rdf:resource="https://saref.etsi.org/core/"/>
    <skos:historyNote xml:lang="en">V3.2.1: Introduce saref:madeBy (resp. saref:madeExecution) as generalization of saref:measurementMadeBy (resp. saref:makesMeasurement).</skos:historyNote>
    <rdfs:range rdf:resource="https://saref.etsi.org/core/FeatureOfInterest"/>
    <rdfs:domain rdf:resource="https://saref.etsi.org/core/ProcedureExecution"/>
    <rdfs:comment xml:lang="en">Links a procedure execution to the entity (e.g., device) that made it.</rdfs:comment>
    <rdfs:label xml:lang="en">made by</rdfs:label>
    <owl:inverseOf rdf:resource="https://saref.etsi.org/core/madeExecution"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A10">
    <foaf:name>George Routis</foaf:name>
    <schema:affiliation rdf:nodeID="A13"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://saref.etsi.org/core/isPropertyOf">
    <rdfs:isDefinedBy rdf:resource="https://saref.etsi.org/core/"/>
    <rdfs:range rdf:nodeID="A6"/>
    <rdfs:domain rdf:resource="https://saref.etsi.org/core/Property"/>
    <rdfs:comment xml:lang="en">Links a property to the feature kind or feature of interest it is a property of.</rdfs:comment>
    <rdfs:label xml:lang="en">is property of</rdfs:label>
    <owl:inverseOf rdf:resource="https://saref.etsi.org/core/hasProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A14">
    <foaf:name>PSNC</foaf:name>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A9">
    <foaf:name>Rob Atkinson</foaf:name>
    <schema:affiliation rdf:nodeID="A0"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A13">
    <foaf:name>ICCS</foaf:name>
  </rdf:Description>
  <rdf:Description rdf:about="https://saref.etsi.org/core/isObservedBy">
    <rdfs:isDefinedBy rdf:resource="https://saref.etsi.org/core/"/>
    <rdfs:comment xml:lang="en">Links a feature, property, or state, to the device, function, command, or procedure execution, that observes it.</rdfs:comment>
    <rdfs:label xml:lang="en">is observed by</rdfs:label>
    <owl:inverseOf rdf:resource="https://saref.etsi.org/core/observes"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://saref.etsi.org/core/hasPhenomenonTime">
    <rdfs:comment xml:lang="en">Links a procedure execution to the time that the result applies. It may be an interval or an instant, or some other compound temporal entity expressed using OWL Time.</rdfs:comment>
    <rdfs:label xml:lang="en">has phenomenon time</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A5">
    <owl:unionOf rdf:nodeID="A12"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A11">
    <foaf:name>Raul Palma</foaf:name>
    <rdfs:seeAlso rdf:resource="http://orcid.org/0000-0003-4289-4922"/>
    <schema:affiliation rdf:nodeID="A14"/>
  </rdf:Description>
</rdf:RDF>
